[Unit]
Description=Amazon Elastic Container Service - DCGM Go bindings
Wants=nvidia-dcgm.service
After=nvidia-dcgm.service
ConditionPathExists=/usr/bin/nv-hostengine

[Service]
Type=simple
Restart=on-failure
RestartSec=10s
# Load ECS_LOGLEVEL (and other ECS settings) from the shared agent config, the
# same file ecs.service reads. The leading '-' makes it optional so dcgm-init
# still starts if the file is absent. dcgm-init's logger reads ECS_LOGLEVEL.
EnvironmentFile=-/etc/ecs/ecs.config
ExecStart=/usr/libexec/dcgm-init start

[Install]
WantedBy=multi-user.target
