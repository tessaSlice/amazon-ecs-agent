[Unit]
Description=Amazon Elastic Container Service - DCGM Go bindings
Wants=nvidia-dcgm.service
After=nvidia-dcgm.service
ConditionPathExists=/run/nvidia-dcgm/nv-hostengine

[Service]
Type=simple
Restart=on-failure
RestartPreventExitStatus=5
RestartSec=10s
# ECS_LOGLEVEL (and other ECS_* settings) are read from the shared ECS config
# file, mirroring ecs.service. dcgm-init's logger.InitSeelog() consumes
# ECS_LOGLEVEL to set the seelog level. The leading '-' makes the file optional.
EnvironmentFile=-/etc/ecs/ecs.config
ExecStartPre=/bin/bash -c 'if [ $(/usr/bin/systemctl is-active nv-hostengine) != "active" ]; then exit 1; fi'
ExecStart=/usr/libexec/dcgm-init start
ExecStop=/usr/libexec/dcgm-init stop

[Install]
WantedBy=multi-user.target
